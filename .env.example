# 이 파일을 .env.local로 복사해서 값을 채우세요.

# Auth.js 서명 키 (생성: npx auth secret)
AUTH_SECRET=
# Vercel 이외의 환경(next start, Docker 등)에서 실행할 때 필요합니다.
AUTH_TRUST_HOST=true

# 데모 계정: 로그인 폼에 미리 채워집니다. 공개되어도 괜찮은 값만 사용하세요.
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo1234

# GitHub OAuth (선택): 두 값이 모두 있으면 GitHub 로그인 버튼이 나타납니다.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# PostgreSQL (선택): Supabase 또는 Neon 무료 플랜의 연결 문자열
DATABASE_URL=
